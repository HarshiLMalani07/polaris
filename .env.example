# Clerk — https://dashboard.clerk.com
# Enable the GitHub OAuth connection (for import/export) and Clerk Billing with a "pro" plan.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER_DOMAIN=

# convex — https://dashboard.convex.dev
# The first three are written for you by `npx convex dev`.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
# Shared secret the background agent uses to write to Convex. Any long random
# string works. Server-side only — never prefix it with NEXT_PUBLIC_.
POLARIS_CONVEX_INTERNAL_KEY=

# AI
# OPENAI_API_KEY powers the coding agent (gpt-4.1) and title generation (gpt-4o-mini).
# The Gemini and Mistral keys are optional — only needed if you switch models.
GOOGLE_GENERATIVE_AI_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=

# Inngest — run in local dev mode (no signing key required)
# Start it with `npx inngest-cli@latest dev`. In production, drop INNGEST_DEV and
# set INNGEST_EVENT_KEY / INNGEST_SIGNING_KEY from https://app.inngest.com instead.
INNGEST_DEV=1

# Firecrawl — https://firecrawl.dev (optional)
# Enables the agent's web scraping tool. Without it, that tool is unavailable.
FIRECRAWL_API_KEY=

# sentry — https://sentry.io (optional)
# Only needed to upload source maps at build time.
SENTRY_AUTH_TOKEN=
